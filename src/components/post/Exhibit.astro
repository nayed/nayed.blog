---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** One screenshot inside <Exhibits>, labelled underneath in small caps. */
interface Props {
  src: ImageMetadata;
  alt: string;
  label: string;
}

const { src, alt, label } = Astro.props;
---

<div class="exhibit">
  <Image
    class="photo"
    src={src}
    alt={alt}
    widths={[400, 800, 1200, 1920]}
    sizes="(min-width: 900px) 300px, 100vw"
    data-zoom
    data-full-width={src.width}
  />
  <div class="label">{label}</div>
</div>

<style>
  .exhibit :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
  }
  .label {
    margin-top: 7px;
    text-align: center;
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
