---
import { EDITIONS } from '../../lib/editions';

const papers = Object.fromEntries(EDITIONS.map((e) => [e.id, e.paper]));
---

<!--
  Runs before first paint so the wrong edition never flashes.
  Every reader starts on the Morning Edition, whatever their system theme;
  the edition they pick with the button is saved and applied here.
-->
<script is:inline define:vars={{ papers }}>
  (function () {
    var edition;
    try {
      edition = localStorage.getItem('edition');
    } catch (e) {}
    if (!papers[edition]) edition = 'morning';
    document.documentElement.dataset.edition = edition;
    document.querySelector('meta[name="theme-color"]').content = papers[edition];
  })();
</script>

<script>
  // The router swaps in the next page's <html> attributes and head, which
  // know nothing of the reader's edition; carry it over before they land.
  document.addEventListener('astro:before-swap', ({ newDocument }) => {
    const edition = document.documentElement.dataset.edition;
    if (edition) newDocument.documentElement.dataset.edition = edition;
    const paper = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content;
    newDocument.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = paper;
  });
</script>
