---
import { EDITIONS } from '../../lib/editions';

const papers = Object.fromEntries(EDITIONS.map((e) => [e.id, e.paper]));
---

<!--
  Runs before first paint so the wrong edition never flashes.
  Every reader starts on the Morning Edition, whatever their system theme;
  the edition they pick with the button is saved and applied here.
-->
<script is:inline define:vars={{ papers }}>
  (function () {
    var edition;
    try {
      edition = localStorage.getItem('edition');
    } catch (e) {}
    if (!papers[edition]) edition = 'morning';
    document.documentElement.dataset.edition = edition;
    document.querySelector('meta[name="theme-color"]').content = papers[edition];
  })();
</script>
